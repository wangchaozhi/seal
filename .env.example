# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_ENABLE_BROWSER_DETERRENCE=false

# Backend
APP_ADDR=:8080
APP_ORIGIN=http://localhost:5173
APP_ENV=development
APP_MAX_BODY_BYTES=1048576
APP_RATE_LIMIT_PER_MINUTE=120
APP_DATA_DIR=./tmp/data
APP_DOWNLOAD_TOKEN_TTL_SECONDS=120
APP_PAYMENT_CALLBACK_SECRET=development-payment-secret-change-me
APP_ENABLE_PAYMENT_SIMULATION=true
APP_RASTERIZER_URL=http://localhost:8090
APP_ADMIN_EMAIL=admin@example.com
# Base32 TOTP secret. Required when APP_ENV=production and APP_ADMIN_EMAIL is set.
APP_ADMIN_MFA_SECRET=
# QQ互联网站应用；回调地址留空时根据 APP_ORIGIN 自动生成。
APP_QQ_APP_ID=
APP_QQ_APP_SECRET=
APP_QQ_REDIRECT_URL=
# 微信开放平台已审核的网站应用。
APP_WECHAT_APP_ID=
APP_WECHAT_APP_SECRET=
APP_WECHAT_REDIRECT_URL=
# GitHub OAuth App。
APP_GITHUB_CLIENT_ID=
APP_GITHUB_CLIENT_SECRET=
APP_GITHUB_REDIRECT_URL=
# Google Cloud OAuth 2.0 Web Client。
APP_GOOGLE_CLIENT_ID=
APP_GOOGLE_CLIENT_SECRET=
APP_GOOGLE_REDIRECT_URL=
APP_DATABASE_URL=postgres://seal_platform:local-development-only@localhost:5432/seal_platform?sslmode=disable
APP_REDIS_URL=redis://localhost:6379/0
