{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/seal-config.schema.json",
  "title": "SealConfig",
  "type": "object",
  "required": ["schemaVersion", "shape", "canvas", "color", "border", "layers", "texture"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "integer", "const": 2},
    "shape": {"enum": ["circle", "ellipse", "square"]},
    "canvas": {
      "type": "object",
      "required": ["logicalWidth", "logicalHeight", "exportWidth"],
      "properties": {
        "logicalWidth": {"type": "integer", "const": 1000},
        "logicalHeight": {"type": "integer", "const": 1000},
        "exportWidth": {"type": "integer", "minimum": 300, "maximum": 5000},
        "transparent": {"type": "boolean", "default": true}
      },
      "additionalProperties": false
    },
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "border": {
      "type": "object",
      "required": ["width", "doubleLine", "innerRing", "innerAdjust"],
      "properties": {
        "width": {"type": "number", "minimum": 1, "maximum": 20},
        "doubleLine": {"type": "boolean"},
        "innerRing": {"type": "boolean"},
        "innerAdjust": {"type": "number", "minimum": -50, "maximum": 50}
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "kind", "visible", "locked", "zIndex"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64},
          "kind": {"enum": ["arcText", "text", "centerText", "centerImage", "border", "innerRing"]},
          "visible": {"type": "boolean"},
          "locked": {"type": "boolean"},
          "zIndex": {"type": "integer", "minimum": 0, "maximum": 100},
          "content": {"type": "string", "maxLength": 100},
          "fontId": {"type": "string", "maxLength": 64},
          "fontSize": {"type": "number", "minimum": 6, "maximum": 400},
          "letterSpacing": {"type": "number", "minimum": -20, "maximum": 100},
          "scaleX": {"type": "number", "minimum": 0.2, "maximum": 3},
          "scaleY": {"type": "number", "minimum": 0.2, "maximum": 3},
          "rotation": {"type": "number", "minimum": -360, "maximum": 360},
          "offsetX": {"type": "number", "minimum": -500, "maximum": 500},
          "offsetY": {"type": "number", "minimum": -500, "maximum": 500},
          "radiusX": {"type": "number", "minimum": 10, "maximum": 500},
          "radiusY": {"type": "number", "minimum": 10, "maximum": 500},
          "startAngle": {"type": "number", "minimum": -720, "maximum": 720},
          "sweepAngle": {"type": "number", "minimum": -720, "maximum": 720},
          "assetId": {"type": "string", "maxLength": 128}
        },
        "additionalProperties": false
      }
    },
    "texture": {
      "type": "object",
      "required": ["enabled", "type", "intensity", "density", "grainSize", "edgeWear", "scratchCount", "fade", "seed", "applyTo"],
      "properties": {
        "enabled": {"type": "boolean"},
        "type": {"enum": ["ink", "grain", "edge", "scratch", "paper"]},
        "intensity": {"type": "integer", "minimum": 0, "maximum": 100},
        "density": {"type": "integer", "minimum": 0, "maximum": 100},
        "grainSize": {"type": "integer", "minimum": 1, "maximum": 24},
        "edgeWear": {"type": "integer", "minimum": 0, "maximum": 100},
        "scratchCount": {"type": "integer", "minimum": 0, "maximum": 40},
        "fade": {"type": "integer", "minimum": 0, "maximum": 100},
        "seed": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "applyTo": {
          "type": "array",
          "items": {"enum": ["border", "text", "center"]},
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "rendererVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
  }
}
